	)
	(text_box "Signals to/from RAM decoder (74LS138)\nOriginal decoder activates internal RAM only for ~{RAM0} and ~{RAM4} to ~{RAM5}\nWe want to activate our replacement for every 1KB chunk in BLK0, including ~{RAM1} to ~{RAM3}\nThis will give us the full 8KB in BLK0 - standard 5KB plus 3KB RAM expansion\nGreatly simplified design:\nWe essentially only need the ~{BLK0} select signal, used as an enable on the original 74LS138.\nSo I think we just need to use that same signal as our RAM select ... ?"
		(exclude_from_sim no)
		(at 15.24 17.78 0)
		(size 120.65 95.25)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ce92dc7d-4408-48ae-b604-0edafecac57c")
	)
