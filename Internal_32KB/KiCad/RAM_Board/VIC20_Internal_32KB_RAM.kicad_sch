	)
	(text_box "Signals to/from RAM decoder (74LS138)\nOriginal decoder activates internal RAM only for ~{RAM0} and ~{RAM4} to ~{RAM5}\nWe want to activate our replacement for every 1KB chunk in BLK0, including ~{RAM1} to ~{RAM3}\nThis will give us the full 8KB in BLK0 - standard 5KB plus 3KB RAM expansion"
		(exclude_from_sim no)
		(at 16.51 15.24 0)
		(size 120.65 54.61)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ce92dc7d-4408-48ae-b604-0edafecac57c")
	)
	(text_box "Original 2114 RAM chips are removed from the VIC.\nTwo are replaced with IC sockets so daughterboard can be installed."
		(exclude_from_sim no)
		(at 142.24 16.51 0)
		(size 72.39 46.99)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cecd90c8-2bf3-478a-b2cd-a1a7a09f525a")
	)
	(text_box "Signals to/from BLK decoder (74LS138)\nWe want to pass ~{BLK0} back so it can be used for ~{BLK0} handling like normal (input to RAM decoder)\nWe want to capture ~{BLK1} to ~{BLK3} selects and use for our RAM expansion\nBut we also want to be able to disable the expansion for software compatibility\nThis can be done via a switch: \n* When the switch is high, the ~{BLK1}/~{BLK2}/~{BLK3} are passed back to the VIC, disconnecting our RAM expansion from the data bus and passing through to the cartridge port\n* When the switch is low, these are blocked which prevents the VIC from disconnecting our RAM from the data bus"
		(exclude_from_sim no)
		(at 16.51 73.66 0)
		(size 120.65 116.84)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "da84de2e-f477-451a-8667-00e3eeca34f8")
	)
