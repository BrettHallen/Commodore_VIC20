	(text_box "Signals to/from RAM decoder (74LS138)\nOriginal decoder activates internal RAM only for ~{RAM0} and ~{RAM4} to ~{RAM5}\nWe want to activate our replacement for every 1KB chunk in BLK0, including ~{RAM1} to ~{RAM3}\nThis will give us the full 8KB in BLK0 - standard 5KB plus 3KB RAM expansion"
		(exclude_from_sim no)
		(at 16.51 15.24 0)
		(size 120.65 54.61)
		(margins 0.9525 0.9525 0.9525 0.9525)
