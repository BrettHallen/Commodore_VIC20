	(text_box "Refer to the \"DIP-16 Breakout Board\" for the J1 & J2 connection"
		(exclude_from_sim no)
		(at 146.05 67.31 0)
		(size 68.58 3.81)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
