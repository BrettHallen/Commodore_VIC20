	(text_box "BLK5 Expansion\nSneak in an extra 8KB as either RAM (6264) or ROM (2764/2864), like SUPER EXPANDER"
		(exclude_from_sim no)
		(at 138.43 76.2 0)
		(size 58.42 83.82)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "14b22cf1-e0c8-4a88-b107-ee56b958f619")
	)
	(text_box "32KB RAM Expansion\nRead: ~{CS} low & VR/~{W} high → ~{OE} low\nWrite: ~{CS} low & VR/~{W} low → ~{OE} high\nDave's comment: The internal logic will take over if ~{OE} is tied low. It will only output if ~{CS} is low and ~{WE} is high."
		(exclude_from_sim no)
		(at 200.66 87.63 0)
		(size 81.28 72.39)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1d14e5c2-7413-4ad8-9dc9-4c88a8ac48a7")
	)
	(text_box "Refer to the \"DIP-16 Breakout Board\" for the RAM/BLK Decoder connection"
		(exclude_from_sim no)
		(at 195.58 173.99 0)
		(size 77.47 3.81)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
