				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7ad5a518-a3d7-4dc6-8f30-d337b9309df3")
	)
	(text_box "Signals to/from RAM decoder (74LS138)\nOriginal decoder activates internal RAM only for ~{RAM0} and ~{RAM4} to ~{RAM5}\nNow greatly simplified - we essentially don't need to care about the ~{RAMx} signals at all, just pull all the original 74LS138 outputs high.\nBut we do need to use the incoming signals."
		(exclude_from_sim no)
		(at 13.97 13.97 0)
		(size 53.34 57.15)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ce92dc7d-4408-48ae-b604-0edafecac57c")
	)
	(text_box "Original 2114 RAM chips are removed from the VIC.\nTwo are replaced with IC sockets so daughterboard can be installed."
		(exclude_from_sim no)
		(at 68.58 13.97 0)
		(size 74.93 48.26)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cecd90c8-2bf3-478a-b2cd-a1a7a09f525a")
	)
	(text_box "Signals to/from BLK decoder (74LS138)\nWhen our expansion is active we want to prevent ~{BLK1}/~{BLK2}/~{BLK3}/~{BLK5} selects returning to the VIC\nBut we also want to be able to disable the expansion for software compatibility\nThis can be done via a switch: \n* When the expansion is disabled the ~{BLK1}/~{BLK2}/~{BLK3}/~{BLK5} are passed back to the VIC, disconnecting our RAM expansion from the data bus and passing through to the cartridge port\n* When the expansion is enabled, these are blocked which prevents the VIC from disconnecting our RAM from the data bus"
		(exclude_from_sim no)
		(at 16.51 73.66 0)
		(size 120.65 116.84)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "da84de2e-f477-451a-8667-00e3eeca34f8")
	)
	(text_box "Power & Decoupling"
		(exclude_from_sim no)
		(at 147.32 17.78 0)
		(size 54.61 29.21)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e28d87b5-494f-46ee-9979-cc9d15d709a6")
	)
	(text_box "Remove lots of different logic gates with a single PLD\nWe need to handle whether CPU or VIC needs to access the RAM\nWhen SΦ2 is low, CPU is accessing RAM and CA13/CA14 are valid\nWhen SΦ2 is high, VIC is accessing RAM and CA13/CA14 must be low as VIC only reads BLK0\nIf expansion is disabled then route ~{BLK1}/~{BLK2}/~{BLK3}/~{BLK5} back to motherboard\n\n~{RAM_CS} = (SΦ2 .AND. ~{CA15}) .OR. (~{SΦ2} .AND. VA13)\nRAM_A13 = (SΦ2 .AND. CA13)\nRAM_A14 = (SΦ2 .AND. CA14)\n~{BLKx_OUT} = (ENABLE .AND. ~{BLKx}}"
		(exclude_from_sim no)
		(at 210.82 15.24 0)
		(size 69.85 68.58)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e8195598-b1ee-446e-866a-97022088dd21")
	)
